rules_version = '2';

// Role-based access for CareConnect. The app's queries are scoped the same
// way (CareRepository), but these rules are the actual security boundary.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function isCaregiver() { return signedIn() && me().role == 'caregiver'; }
    function myEmail() { return request.auth.token.email.lower(); }
    function resident(rid) { return get(/databases/$(db)/documents/residents/$(rid)).data; }
    function isAssignedCaregiver(rid) { return isCaregiver() && request.auth.uid in resident(rid).caregiverIds; }
    function isFamilyOf(rid) { return signedIn() && myEmail() in resident(rid).familyEmails; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['caregiver', 'family'];
      // The role can't be changed after sign-up.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
    }

    match /residents/{rid} {
      allow read: if signedIn() && (
        (isCaregiver() && request.auth.uid in resource.data.caregiverIds)
        || myEmail() in resource.data.familyEmails);
      allow create: if isCaregiver() && request.auth.uid in request.resource.data.caregiverIds;
      allow update: if isAssignedCaregiver(rid);

      match /tasks/{tid} {
        allow read: if isAssignedCaregiver(rid) || isFamilyOf(rid);
        allow create: if isAssignedCaregiver(rid);
        // Caregivers may only tick tasks off, not rewrite them.
        allow update: if isAssignedCaregiver(rid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneAt', 'doneBy']);
      }

      match /vitals/{vid} {
        allow read: if isAssignedCaregiver(rid) || isFamilyOf(rid);
        allow create: if isAssignedCaregiver(rid)
          && request.resource.data.recordedById == request.auth.uid
          && request.resource.data.value is number;
        // Vitals are an audit trail: no updates or deletes from clients.
      }
    }
  }
}
